# Copy to .env.local. Never commit the real one — .gitignore already covers it.

# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Port 6543, NOT 5432. src/db.ts refuses 5432 on purpose: a direct connection
# works locally and exhausts Postgres once a few serverless functions are warm.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# The password for the web page. Invent one; there are no accounts because
# there is one user. Also signs the session cookie, so changing it signs you out.
APP_PASSWORD=

# Optional, and off by default. Leave empty and nothing is posted anywhere —
# the web page is the primary surface. Add a webhook later if you want pushes.
DISCORD_WEBHOOK_URL=

# Optional: send sweep failures somewhere quieter than the alert channel.
DISCORD_OPS_WEBHOOK_URL=

# A long random string you invent. The Watcher presents it as a bearer token;
# without it every state-changing endpoint refuses. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=
