{
  "name": "half-a-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catalog discovery hub \u2014 knows when a SKU appears before it is buyable",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vercel dev",
    "deploy": "npm run build && vercel deploy --prod",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=4 test/*.test.ts",
    "db:push": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/migrate.ts schema.sql",
    "db:seed": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/migrate.ts seed.sql",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/index.js --banner:js=\"// Generated by npm run build from src/server.ts. Do not edit.\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "postgres": "^3.4.9"
  }
}