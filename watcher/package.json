{
  "name": "phantom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watches retailers from your own machine, on your own connection",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node --experimental-strip-types src/index.ts setup",
    "watch": "node --experimental-strip-types src/index.ts watch",
    "stop": "node --experimental-strip-types src/index.ts stop",
    "once": "node --experimental-strip-types src/index.ts once",
    "scan": "node --experimental-strip-types src/index.ts scan",
    "discover": "node --experimental-strip-types src/index.ts discover",
    "signin": "node --experimental-strip-types src/index.ts signin",
    "report": "node --experimental-strip-types src/index.ts report",
    "update": "node --experimental-strip-types src/index.ts update",
    "probe": "node --experimental-strip-types src/index.ts probe",
    "browser": "node --experimental-strip-types src/index.ts browser",
    "help": "node --experimental-strip-types src/index.ts help",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "package": "node --experimental-strip-types scripts/package.ts",
    "typecheck": "tsc --noEmit",
    "inspect": "node --experimental-strip-types src/index.ts inspect",
    "buy-timing": "node --experimental-strip-types scripts/buy-timing.ts",
    "footprint": "node --experimental-strip-types scripts/footprint.ts",
    "batch-probe": "node --experimental-strip-types scripts/batch-probe.ts",
    "search-vs-pdp": "node --experimental-strip-types scripts/search-vs-pdp.ts",
    "onefetch": "node --experimental-strip-types scripts/onefetch.ts",
    "coverage": "node --experimental-strip-types scripts/coverage.ts",
    "facet": "node --experimental-strip-types scripts/facet.ts"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
